<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Afterlife.App</RootNamespace>
    <AssemblyName>AFTERLIFE</AssemblyName>
    <ApplicationIcon>Assets\afterlife.ico</ApplicationIcon>
    <Product>AFTERLIFE</Product>
    <Description>Unofficial mod manager for Cyberpunk 2077</Description>
    <!-- the app is English only: leave out the translated .NET and WPF resources (folders cs, de, fr … next to the exe) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- -p:Edition=Offline builds AFTERLIFE Offline (see AppEdition.cs) -->
  <PropertyGroup Condition="'$(Edition)' == 'Offline'">
    <DefineConstants>$(DefineConstants);OFFLINE</DefineConstants>
    <Product>AFTERLIFE Offline</Product>
  </PropertyGroup>
  <!-- -p:Edition=OAuthPreview builds the marked test build of Log in with Nexus Mods (see AppEdition.cs) -->
  <PropertyGroup Condition="'$(Edition)' == 'OAuthPreview'">
    <DefineConstants>$(DefineConstants);OAUTH_PREVIEW</DefineConstants>
    <VersionSuffix Condition="'$(VersionSuffix)' != ''">$(VersionSuffix).oauth-preview</VersionSuffix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">oauth-preview</VersionSuffix>
    <Product>AFTERLIFE OAuth preview</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\afterlife.ico" />
    <None Include="Assets\Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Afterlife.Core\Afterlife.Core.csproj" />
    <ProjectReference Include="..\Afterlife.Infrastructure\Afterlife.Infrastructure.csproj" />
  </ItemGroup>
</Project>
