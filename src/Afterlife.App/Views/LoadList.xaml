<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Afterlife.App.Controls"
                    xmlns:vm="clr-namespace:Afterlife.App.ViewModels">
    <!-- Load list: the preview of an import. EXPORT ORDER and IMPORT ORDER are in the LIST & ORDER menu (ToolsMenu.xaml). -->
    <DataTemplate DataType="{x:Type vm:LoadListPreviewVm}">
        <StackPanel Width="640">
            <TextBlock Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource T2}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" />
            <TextBlock Margin="0,14,0,6" Style="{StaticResource MonoLabel}" Text="{Binding IntoProfile}" />
            <TextBlock Style="{StaticResource Body}" FontSize="12.5" Foreground="{StaticResource T2}" TextWrapping="Wrap"
                       Text="Order, categories and on/off already match the list."
                       Visibility="{Binding NothingChanges, Converter={StaticResource BoolToVis}}" />
            <ScrollViewer MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource GrowWithWindow}, ConverterParameter=320}"
                          VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LoadListGroupVm}">
                            <StackPanel Margin="0,1">
                                <!-- a line with a number; the names open below it -->
                                <Button HorizontalAlignment="Left" Style="{StaticResource LinkButton}" Command="{Binding ToggleCommand}" Focusable="True"
                                        AutomationProperties.Name="{Binding Header}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Width="16" Style="{StaticResource Mono}" FontSize="12" Text="{Binding Arrow}" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource T}" Text="{Binding Header}" TextWrapping="Wrap" MaxWidth="600" />
                                    </StackPanel>
                                </Button>
                                <c:CutBorder Margin="16,4,0,6" Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line2}" CutTopLeft="False" CutTopRight="False" CutBottomRight="True" Cut="8" Padding="12,6"
                                             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LoadListItemVm}">
                                                <DockPanel Margin="0,1">
                                                    <Button DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource QuietLinkButton}" FontSize="11.5"
                                                            Command="{Binding Open}" Content="{Binding OpenLabel}"
                                                            Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Style="{StaticResource Mono}" FontSize="12" Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </c:CutBorder>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <CheckBox Margin="0,14,0,0" Style="{StaticResource PlainCheck}" IsChecked="{Binding SwitchOnOff}" Content="Also switch mods on and off as in the list" />
            <CheckBox Margin="0,6,0,0" Style="{StaticResource PlainCheck}" IsChecked="{Binding SwitchOffOthers}" Content="Switch off mods that are not in the list" />
            <CheckBox Margin="0,6,0,0" Style="{StaticResource PlainCheck}" IsChecked="{Binding UnlockCollections}" Content="Unlock collections and use the order from the list"
                      Visibility="{Binding ShowUnlock, Converter={StaticResource BoolToVis}}" />
            <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Notes}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,0,0,4" Style="{StaticResource Meta}" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource LinkButton}" Command="{Binding GetFromNexusCommand}" Content="{Binding DownloadLabel}" Margin="0,0,18,0"
                        Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding DownloadTip}" />
                <Button Style="{StaticResource QuietLinkButton}" Command="{Binding CancelCommand}" Content="Cancel" Margin="0,0,18,0" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmCommand}" Content="IMPORT" MinWidth="150" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Missing mods of a list, page by page on Nexus (free accounts); the progress block is the collection download view (CollectionViews.xaml). -->
    <DataTemplate DataType="{x:Type vm:LoadListQueueVm}">
        <StackPanel Width="640">
            <TextBlock Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource T2}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Meta}" TextWrapping="Wrap"
                       Text="Nexus lets free accounts download only on the website. AFTERLIFE opens the page of each missing mod that names a Nexus file: click Mod Manager Download there and the file comes into the library switched off. Mods the list names without a Nexus file stay as links in IMPORT ORDER." />
            <ContentControl Margin="0,12,0,0" Content="{Binding Progress}" Focusable="False" />
            <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource QuietLinkButton}" Command="{Binding SkipCommand}" Content="Skip this mod" Margin="0,0,18,0"
                        Visibility="{Binding CanSkip, Converter={StaticResource BoolToVis}}"
                        ToolTip="Leave this mod out and open the next page" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding LoadAgainCommand}" Content="LOAD THE LIST AGAIN" MinWidth="150"
                        Visibility="{Binding CanLoadAgain, Converter={StaticResource BoolToVis}}"
                        ToolTip="Show the preview of the same list again, now with the mods that came in" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
