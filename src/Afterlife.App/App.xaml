<Application x:Class="Afterlife.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Afterlife.App.Controls"
             xmlns:app="clr-namespace:Afterlife.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ===== Colour roles (AFTERLIFE-architektura-v2.1.md, "Barvy a priorita sdělení") ===== -->
            <Color x:Key="BgColor">#050508</Color>
            <Color x:Key="Bg2Color">#0A0C12</Color>
            <Color x:Key="Bg3Color">#11141D</Color>
            <Color x:Key="SelColor">#151925</Color>
            <Color x:Key="YColor">#FCEE0A</Color>
            <Color x:Key="CColor">#00F0FF</Color>
            <Color x:Key="MColor">#FF2A6D</Color>
            <Color x:Key="GColor">#39FF8A</Color>
            <Color x:Key="OColor">#FF9F1C</Color>
            <Color x:Key="TColor">#E8E6D9</Color>
            <Color x:Key="T2Color">#8B8F9C</Color>
            <Color x:Key="T3Color">#80869A</Color>
            <Color x:Key="TagTextColor">#C9C7BB</Color>
            <Color x:Key="TagLineColor">#3A4256</Color>
            <Color x:Key="LineColor">#1D2230</Color>
            <Color x:Key="Line2Color">#2A3142</Color>

            <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
            <SolidColorBrush x:Key="Bg3" Color="{StaticResource Bg3Color}" />
            <SolidColorBrush x:Key="Sel" Color="{StaticResource SelColor}" />
            <SolidColorBrush x:Key="Y" Color="{StaticResource YColor}" />
            <SolidColorBrush x:Key="C" Color="{StaticResource CColor}" />
            <SolidColorBrush x:Key="M" Color="{StaticResource MColor}" />
            <SolidColorBrush x:Key="G" Color="{StaticResource GColor}" />
            <SolidColorBrush x:Key="O" Color="{StaticResource OColor}" />
            <SolidColorBrush x:Key="T" Color="{StaticResource TColor}" />
            <SolidColorBrush x:Key="T2" Color="{StaticResource T2Color}" />
            <SolidColorBrush x:Key="T3" Color="{StaticResource T3Color}" />
            <SolidColorBrush x:Key="TagText" Color="{StaticResource TagTextColor}" />
            <SolidColorBrush x:Key="TagLine" Color="{StaticResource TagLineColor}" />
            <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
            <SolidColorBrush x:Key="Line2" Color="{StaticResource Line2Color}" />
            <SolidColorBrush x:Key="YTint" Color="{StaticResource YColor}" Opacity="0.08" />
            <SolidColorBrush x:Key="CTint" Color="{StaticResource CColor}" Opacity="0.08" />
            <SolidColorBrush x:Key="CTintHover" Color="{StaticResource CColor}" Opacity="0.18" />
            <SolidColorBrush x:Key="MTint" Color="{StaticResource MColor}" Opacity="0.10" />
            <SolidColorBrush x:Key="GTint" Color="{StaticResource GColor}" Opacity="0.10" />
            <SolidColorBrush x:Key="OTint" Color="{StaticResource OColor}" Opacity="0.10" />
            <SolidColorBrush x:Key="Scrim" Color="#050508" Opacity="0.82" />


            <!-- ===== Logo (exact geometry of design/gen_concept03.py LOGO_INNER, 120 × 120 units) ===== -->
            <DrawingBrush x:Key="RasterBrush" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute" Viewbox="0,0,12,12" ViewboxUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H12 V12 H0 Z" />
                        <GeometryDrawing Geometry="M0,0 H12 V4.2 H0 Z">
                            <GeometryDrawing.Brush>
                                <SolidColorBrush Color="#050508" Opacity="0.55" />
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <Geometry x:Key="LogoMarks">M20 22H40V28H26V42H20Z M100 22H80V28H94V42H100Z M20 102H40V96H26V82H20Z M100 102H80V96H94V82H100Z M46 40L82 62L46 84Z M20 60H34V64H20Z M86 60H100V64H86Z</Geometry>
            <DrawingGroup x:Key="LogoDrawing">
                <GeometryDrawing Brush="{StaticResource Y}" Geometry="M0 0H92L120 28V120H28L0 92Z" />
                <DrawingGroup>
                    <DrawingGroup.Transform><TranslateTransform X="-2.4" /></DrawingGroup.Transform>
                    <GeometryDrawing Brush="{StaticResource C}" Geometry="{StaticResource LogoMarks}" />
                </DrawingGroup>
                <DrawingGroup>
                    <DrawingGroup.Transform><TranslateTransform X="2.4" /></DrawingGroup.Transform>
                    <GeometryDrawing Brush="{StaticResource M}" Geometry="{StaticResource LogoMarks}" />
                </DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Bg}" Geometry="{StaticResource LogoMarks}" />
                <GeometryDrawing Brush="{StaticResource M}" Geometry="M38 92H82V95H38Z M9 9H18V18H9Z" />
                <GeometryDrawing Geometry="M108 100V108H100">
                    <GeometryDrawing.Pen><Pen Brush="{StaticResource Bg}" Thickness="3" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
            <DrawingGroup x:Key="LogoRasterDrawing">
                <StaticResource ResourceKey="LogoDrawing" />
                <GeometryDrawing Brush="{StaticResource RasterBrush}" Geometry="M0 0H92L120 28V120H28L0 92Z" />
            </DrawingGroup>
            <DrawingImage x:Key="LogoImage" Drawing="{StaticResource LogoDrawing}" />
            <!-- Brand: big logo + three smaller rastered copies (concept 04 header and footer) -->
            <DrawingImage x:Key="BrandImage">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <DrawingGroup Transform="0.5333,0,0,0.5333,0,0">
                            <StaticResource ResourceKey="LogoDrawing" />
                        </DrawingGroup>
                        <DrawingGroup Transform="0.18133,0,0,0.18133,70.4,0">
                            <StaticResource ResourceKey="LogoRasterDrawing" />
                        </DrawingGroup>
                        <DrawingGroup Transform="0.15467,0,0,0.15467,70.4,24.96">
                            <StaticResource ResourceKey="LogoRasterDrawing" />
                        </DrawingGroup>
                        <DrawingGroup Transform="0.128,0,0,0.128,70.4,46.72">
                            <StaticResource ResourceKey="LogoRasterDrawing" />
                        </DrawingGroup>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <!-- ===== Fonts: bundled OFL fonts with Windows fallbacks ===== -->
            <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Chakra Petch, Bahnschrift, Segoe UI</FontFamily>
            <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">pack://application:,,,/Assets/Fonts/#JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

            <app:BoolToVisibility x:Key="BoolToVis" />
            <app:BoolToVisibility x:Key="InverseBoolToVis" Invert="True" />
            <app:NullToVisibility x:Key="NullToVis" />
            <app:InverseBool x:Key="Not" />
            <app:CollectionChapterToVisibility x:Key="CollectionChapterVis" />
            <app:ChapterLookupConverter x:Key="ChapterLookup" />
            <app:ToneToBrush x:Key="ToneBrush" />
            <app:ToneToBrush x:Key="ToneTint" Tint="True" />

            <!-- ===== Focus ring: separate, always visible on keyboard focus ===== -->
            <Style x:Key="FocusRing">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="-3" Stroke="{StaticResource Y}" StrokeThickness="2" SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Text ===== -->
            <Style x:Key="PanelTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource Y}" />
            </Style>
            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource T}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Meta" TargetType="TextBlock" BasedOn="{StaticResource Body}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource T2}" />
            </Style>
            <Style x:Key="Mono" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource T}" />
            </Style>
            <Style x:Key="MonoLabel" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource T2}" />
            </Style>

            <!-- ===== Buttons ===== -->
            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Foreground" Value="{StaticResource C}" />
                <Setter Property="Background" Value="{StaticResource CTint}" />
                <Setter Property="BorderBrush" Value="{StaticResource C}" />
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <c:CutBorder x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Cut="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </c:CutBorder>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="Background" Value="{StaticResource CTintHover}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
                <Setter Property="Foreground" Value="{StaticResource Bg}" />
                <Setter Property="Background" Value="{StaticResource Y}" />
                <Setter Property="BorderBrush" Value="{StaticResource Y}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <c:CutBorder x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Cut="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </c:CutBorder>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Frame" Property="Background" Value="{StaticResource Bg3}" />
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Line2}" />
                                    <Setter Property="Foreground" Value="{StaticResource T3}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
                <Setter Property="Foreground" Value="{StaticResource O}" />
                <Setter Property="Background" Value="{StaticResource OTint}" />
                <Setter Property="BorderBrush" Value="{StaticResource O}" />
            </Style>
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
                <Setter Property="Foreground" Value="{StaticResource M}" />
                <Setter Property="Background" Value="{StaticResource MTint}" />
                <Setter Property="BorderBrush" Value="{StaticResource M}" />
            </Style>
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Foreground" Value="{StaticResource C}" />
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="0,2">
                                <ContentPresenter x:Name="P" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="P" Property="Opacity" Value="0.8" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource T3}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="QuietLinkButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
                <Setter Property="Foreground" Value="{StaticResource T2}" />
            </Style>

            <!-- WANT toggle: 40 × 24, yellow outline = on -->
            <Style x:Key="WantToggle" TargetType="CheckBox">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Border x:Name="Track" Background="{StaticResource Bg3}" BorderBrush="{StaticResource T3}" BorderThickness="1.5" />
                                <Border x:Name="Knob" Width="15" Height="14" HorizontalAlignment="Left" Margin="4,0" Background="{StaticResource T3}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource Bg}" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Y}" />
                                    <Setter TargetName="Knob" Property="Background" Value="{StaticResource Y}" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PlainCheck" TargetType="CheckBox">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Foreground" Value="{StaticResource T}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent" MinHeight="24">
                                <Border x:Name="Box" Width="18" Height="18" BorderBrush="{StaticResource T3}" BorderThickness="1.5" Background="{StaticResource Bg3}" VerticalAlignment="Center">
                                    <Rectangle x:Name="Mark" Width="10" Height="10" Fill="{StaticResource Y}" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Y}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- round choice in the same look -->
            <!-- P70: progress bar in the Cyberpunk style: cut corner frame, segmented neon fill, the colour comes from Foreground -->
            <Style x:Key="NeonBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="14" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="Foreground" Value="{StaticResource C}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid ClipToBounds="True">
                                <Path Stretch="Fill" Data="M0,0 H96 L100,4 V10 H4 L0,6 Z" Fill="{StaticResource Bg}" Stroke="{StaticResource Line2}" StrokeThickness="1" />
                                <Border x:Name="PART_Track" Margin="3,3,3,3" />
                                <Border x:Name="PART_Indicator" Margin="3,3,3,3" HorizontalAlignment="Left">
                                    <Grid>
                                        <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.9" />
                                        <!-- segments -->
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <DrawingBrush TileMode="Tile" Viewport="0,0,6,8" ViewportUnits="Absolute">
                                                    <DrawingBrush.Drawing>
                                                        <GeometryDrawing Brush="#AA050508">
                                                            <GeometryDrawing.Geometry>
                                                                <RectangleGeometry Rect="4,0,2,8" />
                                                            </GeometryDrawing.Geometry>
                                                        </GeometryDrawing>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle Width="2" HorizontalAlignment="Right" Fill="{StaticResource T}" Opacity="0.8" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PlainRadio" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Foreground" Value="{StaticResource T}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <StackPanel Orientation="Horizontal" Background="Transparent" MinHeight="24">
                                <Border x:Name="Box" Width="18" Height="18" CornerRadius="9" BorderBrush="{StaticResource T3}" BorderThickness="1.5" Background="{StaticResource Bg3}" VerticalAlignment="Center">
                                    <Ellipse x:Name="Mark" Width="8" Height="8" Fill="{StaticResource Y}" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Y}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Detail tabs -->
            <Style x:Key="TabRadio" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Foreground" Value="{StaticResource T2}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,18,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="Transparent" MinHeight="28">
                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" Margin="0,0,0,4" />
                                <Rectangle x:Name="Bar" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource Y}" Visibility="Hidden" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Y}" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Text input -->
            <Style x:Key="DarkTextBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource T}" />
                <Setter Property="Background" Value="{StaticResource Bg3}" />
                <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
                <Setter Property="CaretBrush" Value="{StaticResource Y}" />
                <Setter Property="SelectionBrush" Value="{StaticResource C}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Y}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Scrollbars -->
            <Style x:Key="ScrollThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="T" Background="{StaticResource Line2}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="T" Property="Background" Value="{StaticResource T3}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Height" Value="8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" />
                                        </Track.Thumb>
                                    </Track>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Selectable rows without the default blue highlight -->
            <Style x:Key="RowItem" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{StaticResource T}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid x:Name="Root" Background="Transparent">
                                <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Fill="{StaticResource Y}" Visibility="Hidden" />
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                    <ContentPresenter Margin="18,8,12,8" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource Bg3}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource Sel}" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CardItem" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{StaticResource T}" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Card" Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line2}" BorderThickness="1" Padding="12,9">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource T3}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource Sel}" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Y}" />
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PlainList" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            </Style>

            <!-- Neutral tag -->
            <Style x:Key="TagBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource TagLine}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="7,1" />
                <Setter Property="Margin" Value="0,0,5,0" />
            </Style>

            <!-- Panel frame -->
            <!-- P17: panels are slightly see-through so the EDDIES background shows at the edges -->
            <SolidColorBrush x:Key="PanelBg" Color="#0A0C12" Opacity="0.80" />
            <Style x:Key="Panel" TargetType="c:CutBorder">
                <Setter Property="Background" Value="{StaticResource PanelBg}" />
                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                <Setter Property="AccentBrush" Value="{StaticResource Y}" />
                <Setter Property="CutTopLeft" Value="True" />
                <Setter Property="CutTopRight" Value="True" />
                <Setter Property="Cut" Value="8" />
                <Setter Property="Padding" Value="20,18,20,18" />
            </Style>


            <!-- Contact: message icon in a chamfered frame (footer and About, P1) -->
            <Style x:Key="MailIconButton" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="ToolTip" Value="silentbob@silentbob.cz" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <c:CutBorder x:Name="Frame" Background="Transparent" BorderBrush="{StaticResource T3}" Cut="8">
                                <Canvas Width="32" Height="32">
                                    <Path Stroke="{StaticResource M}" StrokeThickness="1.5" Opacity="0.55" Data="M8,10 H26 V22 H8 Z M8,10 L17,17 L26,10" />
                                    <Path Stroke="{StaticResource C}" StrokeThickness="1.5" StrokeLineJoin="Miter" Data="M7,10 H25 V22 H7 Z M7,10 L16,17 L25,10" />
                                    <Path Stroke="{StaticResource C}" StrokeThickness="1" Data="M3,29 H8 M3,29 V24" />
                                </Canvas>
                            </c:CutBorder>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource C}" />
                                    <Setter TargetName="Frame" Property="Background" Value="{StaticResource CTint}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{StaticResource Bg3}" />
                <Setter Property="Foreground" Value="{StaticResource T}" />
                <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,5" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
